[alias]
	cdiff = diff --color-words=.
	ci = commit
	co = checkout
	cshow = show --color-words=.
	lg = log --graph
	ll = log -20 --graph
	oops = commit --amend --no-edit
	sclean = clean -ffdx --recurse-submodules
	sforeach = submodule foreach --recursive
	spull = pull --recurse-submodules
	st = status
	stu = status --untracked-files=no
	subdate = submodule update --init --recursive --remote
	supdate = submodule update --init --recursive
	sync = fetch origin --prune --force 'refs/pull-requests/*:refs/pr/*'
[blame]
	date = short
[branch]
	sort = -committerdate
[color "branch"]
	# Blue on black is hard to read in git branch -vv: use cyan instead
	upstream = cyan
[color "grep"]
	linenumber = yellow
	match = red
[column]
	ui = auto
[core]
	editor = emacs
	excludesfile = ~/.gitignore
[diff]
	algorithm = histogram
	colorMoved = dimmed-zebra
	# a/ b/ prefixes become c/ w/ i/ o/ (commit, worktree, index, object)
	mnemonicPrefix = true
	# When using --word-diff, assume --word-diff-regex=.
	wordRegex = .
[fetch]
	prune = true
[filter "lfs"]
	# Needs the git-lfs package: a process filter that cannot start is fatal,
	# so without it every LFS repository fails. Dropping the section is worse
	# still - git would then check out the pointer text as the real content.
	clean = git-lfs clean -- %f
	process = git-lfs filter-process
	required = true
	smudge = git-lfs smudge -- %f
[format]
	pretty = %Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%cr, %cd) %C(bold blue)<%an>%Creset
[help]
	autocorrect = prompt
[init]
	defaultBranch = main
[log]
	abbrevCommit = true
	date = format-local:%Y-%m-%d %H:%M
	follow = true
[merge]
	# zdiff3 is diff3 with the common lines hoisted out of the conflict
	conflictStyle = zdiff3
	tool = ediff
[mergetool]
	keepBackup = false
[mergetool "ediff"]
	cmd = emacs --eval \"(ediff-merge-files-with-ancestor \\\"$LOCAL\\\" \\\"$REMOTE\\\" \\\"$BASE\\\" nil \\\"$MERGED\\\")\"
[pull]
	# This is GREAT... when you know what you're doing and are careful
	# not to pull --no-rebase over a local line containing a true merge.
	rebase = true
[push]
	autoSetupRemote = true
	default = simple
[rebase]
	autoStash = true
[rerere]
	autoupdate = true
	enabled = true
[tag]
	# Version ordering, so 1.10.2 sorts after 1.2.0
	sort = version:refname
[include]
	# Absolute: git resolves a relative include.path against the directory of
	# the file it read - ~/.gitconfig - which is a symlink into this repo, so a
	# bare name would be looked for in src/git/. Last, because includes apply
	# in position order and last one wins.
	path = ~/.gitconfig.private
