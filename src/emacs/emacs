;; C/C++
(use-package cc-mode
  :ensure nil
  :config
  (setq c-default-style "linux"
        c-basic-offset 4)

  ;; ACSL mode configuration
  (defconst acsl-keywords
    '("assert" "assigns" "ensures" "slevel" "slevel_merge" "requires")
    "List of ACSL keywords to highlight.")

  (defvar acsl-font-lock-keywords
    (let ((find-acsl-comment
           (lambda (limit)
             ;; Search for ACSL comment starts: /*@ or //@
             (when (re-search-forward "/[*/]@" limit t)
               (let* ((comment-start (match-beginning 0))
                      (is-block-comment (eq (char-after (1+ comment-start)) ?*))
                      (comment-end
                       (if is-block-comment
                           ;; For /*@ find matching */
                           (save-excursion
                             (goto-char comment-start)
                             (if (search-forward "*/" limit 'move)
                                 (point)
                               limit))
                         ;; For //@ find end of line
                         (save-excursion
                           (goto-char comment-start)
                           (if (search-forward "\n" limit 'move)
                               (1- (point))
                             limit)))))
                 (set-match-data (list comment-start comment-end))
                 (goto-char comment-end)
                 t)))))
      (list
       `(,find-acsl-comment
         (0 'font-lock-doc-face t)
         (,(regexp-opt acsl-keywords 'words)
          ;; Pre-match: rewind to the start of the comment and report its end
          ;; as the search limit for the keyword matcher.
          (progn (goto-char (match-beginning 0)) (match-end 0))
          ;; Post-match: leave point after the comment.
          (goto-char (match-end 0))
          (0 '(:inherit (font-lock-doc-face bold)) t)))))
    "Default highlighting for ACSL mode.")

  (defun my-acsl-mode ()
    "Enable ACSL (ANSI/ISO C Specification Language) syntax highlighting."
    (font-lock-add-keywords nil acsl-font-lock-keywords))

  (defun my-cc-style ()
    "Set custom C/C++ style with Linux base and custom offsets."
    (c-set-style "linux")
    (c-set-offset 'innamespace 0)
    (c-set-offset 'inextern-lang 0)
    (c-set-offset 'inline-open 0)
    (c-set-offset 'label '*)
    (c-set-offset 'case-label '*)
    (c-set-offset 'access-label '/)
    (setq c-basic-offset 4))

  (defun my-cc-clang-format-keys ()
    "Set custom keybindings for clang-format in C/C++ modes."
    (local-set-key (kbd "C-M-\\") #'clang-format-region))

  (defun my-cc-mode-setup ()
    "Setup function for C/C++ modes."
    (my-cc-style)
    (my-cc-clang-format-keys)
    (my-acsl-mode))

  (add-to-list 'auto-mode-alist '("\\.ipp\\'" . c++-mode))

  :hook ((c++-mode . my-cc-mode-setup)
         (c-mode . my-cc-mode-setup)))

