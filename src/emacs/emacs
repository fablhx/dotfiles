(use-package emacs
  :ensure nil
  :init
  ;; Unset unwanted keybinding
  (global-unset-key (kbd "C-z"))

  :bind
  ;; Function key bindings
  ([f1] . comment-dwim)
  ([f2] . whitespace-mode)
  ;; [f3] => see rg
  ([f4] . flycheck-mode)
  ([f5] . compile)
  ;; [f6] => interrupt-and-recompile, bound in my-keys-minor-mode-map
  ([f7] . next-error)
  ([f8] . my-pop-local-mark-ring)
  ([(shift f8)] . pop-global-mark)
  ([f9] . my-open-error-location-at-point)
  ([f12] . enlarge-window)

  ;; Window management with auto-balancing
  ("C-x 2" . my-split-window-below-balanced)
  ("C-x 3" . my-split-window-right-balanced)
  ("C-x 0" . my-delete-window-balanced)

  :config
  ;; Editor behavior
  (setq-default
   indent-tabs-mode nil           ; Use spaces instead of tabs
   tab-width 4                    ; Set tab width
   fill-column 80)                ; Set fill column

  ;; UI settings
  (line-number-mode t)            ; Show line numbers
  (column-number-mode t)          ; Show column numbers
  (menu-bar-mode t)               ; Show menu bar
  (tool-bar-mode -1)              ; Hide tool bar
  (scroll-bar-mode -1)            ; Hide scroll bar
  (transient-mark-mode t)         ; Highlight selection
  (delete-selection-mode t)       ; Delete selected text
  (setq use-short-answers t)      ; Use modern y/n
  (global-auto-revert-mode t)     ; Auto reload changed files
  (save-place-mode t)             ; Remember cursor position
  (savehist-mode 1)               ; Persist minibuffer history
  (recentf-mode 1)                ; Track recent files

  ;; Scrolling behavior
  (setq scroll-conservatively 10000
        scroll-margin 3
        scroll-step 1
        auto-window-vscroll nil)

  ;; Enable eldoc for all programming modes
  (add-hook 'prog-mode-hook #'eldoc-mode)

  ;; Various settings
  (setq
   Buffer-menu-name-width 30
   fill-nobreak-predicate '(fill-french-nobreak-p)
   mouse-yank-at-point nil
   query-replace-highlight t
   read-file-name-completion-ignore-case t
   require-final-newline t
   search-whitespace-regexp nil
   vc-follow-symlinks t)

  ;; Custom variables.  `inhibit-startup-echo-area-message' is deliberately
  ;; absent: Emacs only honours it when it can find a literal
  ;; (setq inhibit-startup-echo-area-message "<login>") in `user-init-file',
  ;; which is the byte-compiled .elc here, so it can never match.
  (setq inhibit-startup-message t
        make-backup-files nil
        ring-bell-function #'ignore
        save-abbrevs nil
        search-highlight t)

  ;; Redirect auto-save files out of project directories
  (setq auto-save-file-name-transforms
        `((".*" ,(expand-file-name "auto-save/" user-emacs-directory) t)))
  (let ((auto-save-dir (expand-file-name "auto-save/" user-emacs-directory)))
    (unless (file-directory-p auto-save-dir)
      (make-directory auto-save-dir t)))

  ;; Recentf settings
  (setq recentf-max-saved-items 200
        recentf-max-menu-items 15))

