;; =============================================================================
;;                              Error Locations
;; =============================================================================

(defconst my-error-location-regexp
  "\\([^:\n\t ]+\\):\\([0-9]+\\)\\(?::\\([0-9]+\\)\\)?"
  "Loose match for FILE:LINE[:COL] appearing inside a line of text.")

(defconst my-error-location-suffix-regexp
  "\\`\\(.+?\\):\\([0-9]+\\)\\(?::\\([0-9]+\\)\\)?:?\\'"
  "Anchored match for a whole filename ending in :LINE[:COL].")

(defconst my-error-location-tail-regexp
  ":[0-9]+:?\\'"
  "Cheap necessary condition for `my-error-location-suffix-regexp'.
Anything that regexp accepts ends this way, so a name failing this one cannot
be a location reference.  It exists to keep the non-anchored, backtracking
match off the path every file name takes.")

(defun my-open-error-location--parse (text &optional anchored)
  "Parse TEXT of form FILE:LINE[:COL] and return (FILE LINE COL), or nil.
With ANCHORED non-nil, TEXT must consist entirely of such a reference."
  ;; Match data indexes into the trimmed string, so match-string must read from
  ;; it rather than from TEXT.
  (let ((s (string-trim text)))
    (when (string-match (if anchored
                            my-error-location-suffix-regexp
                          my-error-location-regexp)
                        s)
      (list (match-string 1 s)
            (string-to-number (match-string 2 s))
            (let ((col (match-string 3 s)))
              (and col (string-to-number col)))))))

(defun my-goto-line-column (line col)
  "Move point to LINE and, when non-nil, COL in the current buffer."
  (goto-char (point-min))
  (when (and line (> line 0))
    (forward-line (1- line)))
  (when (and col (> col 0))
    (move-to-column (1- col))))

(defun my-open-error-location-at-point ()
  "Open the FILE:LINE[:COLUMN] reference on the current line.
Path is resolved relative to the current buffer's directory."
  (interactive)
  (let* ((line-text (thing-at-point 'line t))
         (parsed (and line-text (my-open-error-location--parse line-text))))
    (if (not parsed)
        (message "No valid filename:line[:column] pattern found at point.")
      (let* ((rel-file (nth 0 parsed))
             (line (nth 1 parsed))
             (col (nth 2 parsed))
             (base-dir (file-name-directory (or (buffer-file-name) default-directory)))
             (full-path (expand-file-name rel-file base-dir)))
        (if (not (file-exists-p full-path))
            (message "File not found: %s" full-path)
          (let ((target-window (get-window-with-predicate
                                (lambda (win)
                                  (not (eq win (selected-window)))))))
            (when target-window
              (select-window target-window))
            (find-file full-path)
            (my-goto-line-column line col)))))))

(defun my-find-file-noselect--advice-with-line-and-column (orig-fun filename &rest args)
  "Open FILENAME of the form path:LINE[:COL] at that position.
Rewriting is attempted only when FILENAME names no existing file but the
path before the :LINE suffix does.  Anything else - including remote
names and ordinary files that merely contain a colon - is handed to
ORIG-FUN untouched, along with ARGS."
  ;; Every file Emacs opens comes through here, so the tests are ordered by
  ;; cost: an anchored string match rejects almost everything before anything
  ;; touches the filesystem.
  (let ((parsed (and (stringp filename)
                     (string-match-p my-error-location-tail-regexp filename)
                     (not (file-remote-p filename))
                     (not (file-exists-p filename))
                     (my-open-error-location--parse filename t))))
    (if (not parsed)
        (apply orig-fun filename args)
      (let ((file (nth 0 parsed))
            (line (nth 1 parsed))
            (col (nth 2 parsed)))
        (if (not (and file (file-exists-p file)))
            ;; The original name, not the truncated one: that opened the wrong file.
            (apply orig-fun filename args)
          (let ((buf (apply orig-fun file args)))
            (when (buffer-live-p buf)
              (with-current-buffer buf
                (my-goto-line-column line col)))
            buf))))))

(advice-add 'find-file-noselect :around
            #'my-find-file-noselect--advice-with-line-and-column)

;; =============================================================================
;;                         Preprocessor Conditionals
;; =============================================================================

(defconst my-cpp-conditional-regexp
  "^[ \t]*#[ \t]*\\(ifdef\\|ifndef\\|if\\|elif\\|else\\|endif\\)\\_>"
  "Match a conditional preprocessor directive at the start of a line.
The longer keywords come first: the alternation is ordered, so a leading
\"if\" would otherwise win against \"ifdef\".")

(defun my-cpp-directive-at-point ()
  "Return the conditional directive on the current line as a string, or nil."
  (save-excursion
    (beginning-of-line)
    (and (looking-at my-cpp-conditional-regexp)
         (match-string 1))))

(defun my-cpp-matching-position (direction)
  "Return the position of the directive matching the one on the current line.
DIRECTION is 1 to scan forward for the closing #endif, -1 to scan backward
for the opening #if.  Returns nil when the block is unbalanced.  Point is
left where it was."
  (let* ((forward (> direction 0))
         (search (if forward #'re-search-forward #'re-search-backward))
         (depth 1)
         (position nil))
    (save-excursion
      (beginning-of-line)
      ;; Forward, the search would match the directive under point and count it
      ;; a second time; backward it cannot, since the match would extend past
      ;; point.
      (when forward (forward-line 1))
      (while (and (> depth 0)
                  (funcall search my-cpp-conditional-regexp nil t))
        (let ((start (match-beginning 0))
              (keyword (match-string 1)))
          (cond
           ((equal keyword "endif")
            (setq depth (if forward (1- depth) (1+ depth))))
           ((member keyword '("if" "ifdef" "ifndef"))
            (setq depth (if forward (1+ depth) (1- depth)))))
          (when (zerop depth)
            (setq position start)))))
    position))

(defun my-jump-to-matching-ifdef ()
  "Jump between matching #if/#ifdef/#ifndef, #else/#elif and #endif."
  (interactive)
  (let ((directive (my-cpp-directive-at-point)))
    (cond
     ((null directive)
      (message "Not on a preprocessor directive"))
     ((member directive '("if" "ifdef" "ifndef"))
      (if-let* ((target (my-cpp-matching-position 1)))
          (goto-char target)
        (message "No matching #endif found")))
     (t
      (if-let* ((target (my-cpp-matching-position -1)))
          (goto-char target)
        (message "No matching #if found"))))))

