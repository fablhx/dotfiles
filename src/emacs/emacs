;; C/C++
;; ACSL and cc-mode helpers live at top level rather than inside the
;; use-package :config below: defuns nested in a macro body are invisible to
;; the byte-compiler when it checks the :hook references above them.

;; Declarations rather than `(eval-when-compile (require (quote cc-mode)))':
;; `eval-when-compile' is plain `progn' in interpreted code, and this file is
;; installed as source, so that require pulled all of cc-mode into every
;; startup to satisfy the byte-compiler.
(defvar c-basic-offset)
(defvar c-default-style)
(declare-function c-set-style "cc-styles")
(declare-function c-set-offset "cc-vars")

(defconst my-acsl-keywords
  '("assert" "assigns" "ensures" "slevel" "slevel_merge" "requires")
  "List of ACSL keywords to highlight.")

(defvar my-acsl-font-lock-keywords
  (let ((find-acsl-comment
         (lambda (limit)
           ;; Search for ACSL comment starts: /*@ or //@
           (when (re-search-forward "/[*/]@" limit t)
             (let* ((comment-start (match-beginning 0))
                    (is-block-comment (eq (char-after (1+ comment-start)) ?*))
                    (comment-end
                     (if is-block-comment
                         ;; For /*@ find matching */
                         (save-excursion
                           (goto-char comment-start)
                           (if (search-forward "*/" limit 'move)
                               (point)
                             limit))
                       ;; For //@ find end of line
                       (save-excursion
                         (goto-char comment-start)
                         (if (search-forward "\n" limit 'move)
                             (1- (point))
                           limit)))))
               (set-match-data (list comment-start comment-end))
               (goto-char comment-end)
               t)))))
    (list
     `(,find-acsl-comment
       (0 'font-lock-doc-face t)
       (,(regexp-opt my-acsl-keywords 'words)
        ;; Pre-match: rewind to the start of the comment and report its end
        ;; as the search limit for the keyword matcher.
        (progn (goto-char (match-beginning 0)) (match-end 0))
        ;; Post-match: leave point after the comment.
        (goto-char (match-end 0))
        (0 '(:inherit (font-lock-doc-face bold)) t)))))
  "Default highlighting for ACSL mode.")

(defun my-acsl-mode ()
  "Enable ACSL (ANSI/ISO C Specification Language) syntax highlighting."
  (font-lock-add-keywords nil my-acsl-font-lock-keywords))

