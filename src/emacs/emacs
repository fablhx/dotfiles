;; Log file: open <file>:<line>[:<column>]
(defconst my-error-location-regexp
  "\\([^:\n\t ]+\\):\\([0-9]+\\)\\(?::\\([0-9]+\\)\\)?"
  "Loose match for FILE:LINE[:COL] appearing inside a line of text.")

(defconst my-error-location-suffix-regexp
  "\\`\\(.+?\\):\\([0-9]+\\)\\(?::\\([0-9]+\\)\\)?:?\\'"
  "Anchored match for a whole filename ending in :LINE[:COL].")

(defun my-open-error-location--parse (text &optional anchored)
  "Parse TEXT of form FILE:LINE[:COL] and return (FILE LINE COL), or nil.
With ANCHORED non-nil, TEXT must consist entirely of such a reference."
  ;; The match data indexes into the *trimmed* string, so every match-string
  ;; call below must read from that same string rather than from TEXT.
  (let ((s (string-trim text)))
    (when (string-match (if anchored
                            my-error-location-suffix-regexp
                          my-error-location-regexp)
                        s)
      (list (match-string 1 s)
            (string-to-number (match-string 2 s))
            (let ((col (match-string 3 s)))
              (and col (string-to-number col)))))))

(defun my-goto-line-column (line col)
  "Move point to LINE and, when non-nil, COL in the current buffer."
  (goto-char (point-min))
  (when (and line (> line 0))
    (forward-line (1- line)))
  (when (and col (> col 0))
    (move-to-column (1- col))))

(defun my-open-error-location-at-point ()
  "Open the FILE:LINE[:COLUMN] reference on the current line.
Path is resolved relative to the current buffer's directory."
  (interactive)
  (let* ((line-text (thing-at-point 'line t))
         (parsed (and line-text (my-open-error-location--parse line-text))))
    (if (not parsed)
        (message "No valid filename:line[:column] pattern found at point.")
      (let* ((rel-file (nth 0 parsed))
             (line (nth 1 parsed))
             (col (nth 2 parsed))
             (base-dir (file-name-directory (or (buffer-file-name) default-directory)))
             (full-path (expand-file-name rel-file base-dir)))
        (if (not (file-exists-p full-path))
            (message "File not found: %s" full-path)
          (let ((target-window (get-window-with-predicate
                                (lambda (win)
                                  (not (eq win (selected-window)))))))
            (when target-window
              (select-window target-window))
            (find-file full-path)
            (my-goto-line-column line col)))))))

(defun my-find-file-noselect--advice-with-line-and-column (orig-fun filename &rest args)
  "Open FILENAME of the form path:LINE[:COL] at that position.
Rewriting is attempted only when FILENAME names no existing file but the
path before the :LINE suffix does.  Anything else - including remote
names and ordinary files that merely contain a colon - is handed to
ORIG-FUN untouched, along with ARGS."
  (let ((parsed (and (stringp filename)
                     (not (file-remote-p filename))
                     (not (file-exists-p filename))
                     (my-open-error-location--parse filename t))))
    (if (not parsed)
        (apply orig-fun filename args)
      (let ((file (nth 0 parsed))
            (line (nth 1 parsed))
            (col (nth 2 parsed)))
        (if (not (and file (file-exists-p file)))
            ;; Pass the ORIGINAL name through; using the truncated one here
            ;; silently opened the wrong file.
            (apply orig-fun filename args)
          (let ((buf (apply orig-fun file args)))
            (when (buffer-live-p buf)
              (with-current-buffer buf
                (my-goto-line-column line col)))
            buf))))))

(advice-add 'find-file-noselect :around
            #'my-find-file-noselect--advice-with-line-and-column)

;; Define a jump function for ifdef
(defun my-jump-to-matching-ifdef ()
  "Jump between matching #if/#ifdef/#ifndef and #endif."
  (interactive)
  (let ((start-point (point)))
    (beginning-of-line)
    (cond
     ;; On #if/ifdef/ifndef - jump to matching #endif
     ((looking-at "^\\s-*#\\s-*\\(if\\|ifdef\\|ifndef\\)")
      (let ((level 1))
        (while (and (> level 0)
                    (re-search-forward "^\\s-*#\\s-*\\(if\\|ifdef\\|ifndef\\|endif\\)" nil t))
          (beginning-of-line)
          (cond
           ((looking-at "^\\s-*#\\s-*\\(if\\|ifdef\\|ifndef\\)")
            (setq level (1+ level)))
           ((looking-at "^\\s-*#\\s-*endif")
            (setq level (1- level))))
          (unless (zerop level)
            (forward-line)))
        (when (zerop level)
          (beginning-of-line))))

     ;; On #endif - jump back to matching #if
     ((looking-at "^\\s-*#\\s-*endif")
      (let ((level 1))
        (while (and (> level 0)
                    (re-search-backward "^\\s-*#\\s-*\\(if\\|ifdef\\|ifndef\\|endif\\)" nil t))
          (cond
           ((looking-at "^\\s-*#\\s-*endif")
            (setq level (1+ level)))
           ((looking-at "^\\s-*#\\s-*\\(if\\|ifdef\\|ifndef\\)")
            (setq level (1- level)))))))

     ;; On #else or #elif - jump to matching #if with proper nesting
     ((looking-at "^\\s-*#\\s-*\\(else\\|elif\\)")
      (let ((level 1)
            (found nil))
        (while (and (> level 0) (not found)
                    (re-search-backward "^\\s-*#\\s-*\\(if\\|ifdef\\|ifndef\\|endif\\)" nil t))
          (cond
           ((looking-at "^\\s-*#\\s-*endif")
            (setq level (1+ level)))
           ((looking-at "^\\s-*#\\s-*\\(if\\|ifdef\\|ifndef\\)")
            (setq level (1- level))
            (when (zerop level)
              (setq found t)))))
        (unless found
          (goto-char start-point)
          (message "No matching #if found"))))

     ;; Not on a preprocessor directive
     (t
      (goto-char start-point)
      (message "Not on a preprocessor directive")))))

