;; =============================================================================
;;                                Compilation
;; =============================================================================

;; Bound below with plain `define-key': use-package's :bind would autoload these
;; from compile.el, which does not define them.

(defvar my-recompile-origin-buffer nil
  "Buffer `my-interrupt-and-recompile' was called from, while it waits.")

(defun my-recompile-when-finished (buffer _message)
  "Restart the compilation displayed in BUFFER once the interrupted run exits."
  (with-current-buffer buffer
    (remove-hook 'compilation-finish-functions #'my-recompile-when-finished t))
  (let ((origin my-recompile-origin-buffer))
    (setq my-recompile-origin-buffer nil)
    ;; Deferred out of the sentinel: `recompile' erases and reuses the very
    ;; buffer compile.el is still writing the exit message into.
    (run-at-time 0 nil
                 (lambda ()
                   (when (buffer-live-p origin)
                     (with-current-buffer origin
                       (recompile)))))))

(defun my-interrupt-and-recompile ()
  "Interrupt the running compilation, if any, and recompile.
The compilation buffer is interrupted rather than killed: killing it prompts
about the live process, throws away the arguments `recompile' repeats when
called from that buffer, and races the process it just signalled."
  (interactive)
  (let* ((buffer (get-buffer "*compilation*"))
         (process (and buffer (get-buffer-process buffer))))
    (if (not process)
        (recompile)
      (setq my-recompile-origin-buffer (current-buffer))
      (with-current-buffer buffer
        (add-hook 'compilation-finish-functions #'my-recompile-when-finished nil t))
      (interrupt-process process))))

(defun my-compilation-hide (buffer)
  "Bury BUFFER and give back the windows showing it."
  (when (buffer-live-p buffer)
    (dolist (window (get-buffer-window-list buffer nil t))
      ;; quit-window, not bury-buffer plus delete-window: it restores whatever
      ;; the window showed before, and cannot leave a stray window behind when
      ;; the compilation buffer happens to be the selected one.
      (quit-window nil window))))

(defun my-compilation-bury-on-success (status code message)
  "Hide a compilation that ended well, a second after it did.
STATUS, CODE and MESSAGE are as for `compilation-exit-message-function'."
  (when (and (eq status 'exit)
             (zerop code)
             ;; grep, rg and the other compilation-derived modes keep their
             ;; results on screen; only a build hides itself.
             (eq major-mode 'compilation-mode))
    (let ((buffer (current-buffer)))
      (run-with-timer 1 nil #'my-compilation-hide buffer)))
  (cons message code))

;; =============================================================================
;;                           Personal Keymap
;; =============================================================================
;; Top level: `define-minor-mode' inside a use-package :config block warns about
;; non-toplevel `make-variable-buffer-local' and free variables.

(defvar my-keys-minor-mode-map
  (let ((map (make-sparse-keymap)))
    (define-key map (kbd "M-<left>") #'windmove-left)
    (define-key map (kbd "M-<right>") #'windmove-right)
    (define-key map (kbd "M-<up>") #'windmove-up)
    (define-key map (kbd "M-<down>") #'windmove-down)

    (define-key map (kbd "C-S-<up>") #'enlarge-window)
    (define-key map (kbd "C-S-<down>") #'shrink-window)

    (define-key map (kbd "C-c w d") #'delete-trailing-whitespace)
    (define-key map (kbd "C-x C-k") #'my-kill-last-opened-buffer)
    (define-key map (kbd "C-<delete>") #'my-join-next-line)
    (define-key map (kbd "C-c C-s") #'my-sort-ilines)

    (define-key map (kbd "C-c C-f") #'my-open-remote-home)

    (define-key map (kbd "C-c C-l") #'xref-find-definitions)
    (define-key map (kbd "C-c C-b") #'xref-go-back)

    (define-key map (kbd "<f6>") #'my-interrupt-and-recompile)
    (define-key map (kbd "C-c c") #'my-interrupt-and-recompile)

    map)
  "Keymap for `my-keys-minor-mode'.")

(define-minor-mode my-keys-minor-mode
  "A minor mode so that my key settings override annoying major modes."
  :init-value t
  :lighter " my-keys"
  :keymap my-keys-minor-mode-map)

(define-globalized-minor-mode global-my-keys-minor-mode
  my-keys-minor-mode
  (lambda () (my-keys-minor-mode 1))
  :group 'convenience)

(global-my-keys-minor-mode 1)

;; =============================================================================
;;                           Core Emacs Settings
;; =============================================================================

(use-package emacs
  :ensure nil
  :init
  (global-unset-key (kbd "C-z"))

  :bind
  ([f1] . comment-dwim)
  ([f2] . whitespace-mode)
  ([f5] . compile)
  ([f7] . next-error)
  ([f8] . my-pop-local-mark-ring)
  ([(shift f8)] . pop-global-mark)
  ([f9] . my-open-error-location-at-point)
  ([f12] . enlarge-window)

  ("C-x 2" . my-split-window-below-balanced)
  ("C-x 3" . my-split-window-right-balanced)
  ("C-x 0" . my-delete-window-balanced)

  :config
  (setq-default
   indent-tabs-mode nil           ; Use spaces instead of tabs
   tab-width 4                    ; Set tab width
   fill-column 80)                ; Set fill column

  (line-number-mode t)            ; Show line numbers
  (column-number-mode t)          ; Show column numbers
  (menu-bar-mode t)               ; Show menu bar
  (tool-bar-mode -1)              ; Hide tool bar
  (scroll-bar-mode -1)            ; Hide scroll bar
  (transient-mark-mode t)         ; Highlight selection
  (delete-selection-mode t)       ; Delete selected text
  (setq use-short-answers t)      ; Use modern y/n
  (save-place-mode t)             ; Remember cursor position
  (savehist-mode 1)               ; Persist minibuffer history

  ;; `scroll-step' is deliberately absent: `scroll-conservatively' above 100
  ;; overrides it.
  (setq scroll-conservatively 10000
