;; Compilation helpers.  Defined here, and bound below via plain `define-key',
;; because use-package's :bind/:hook would emit
;; (autoload 'interrupt-and-recompile "compile") for a function compile.el does
;; not define - an autoload that can only ever fail.
(defun interrupt-and-recompile ()
  "Interrupt old compilation, if any, and recompile."
  (interactive)
  (let ((compilation-buffer (get-buffer "*compilation*")))
    (when compilation-buffer
      (with-current-buffer compilation-buffer
        (when (get-buffer-process compilation-buffer)
          (interrupt-process (get-buffer-process compilation-buffer))
          (sleep-for 0.1)))  ; Brief pause to allow clean shutdown
      (ignore-errors (kill-buffer compilation-buffer))))
  (recompile))

(defun new-compilation-window-hook ()
  "Create a new window for compilation buffer if not already visible."
  (unless (get-buffer-window "*compilation*")
    (let ((total-height (window-height)))
      (when (> total-height 20)
        (split-window-below (- total-height 15))))))

(add-hook 'compilation-mode-hook #'new-compilation-window-hook)

;; =============================================================================
;;                           Personal Keymap
;; =============================================================================
;; Defined at top level: nesting `define-minor-mode' inside a `use-package'
;; :config block produced byte-compiler warnings about non-toplevel
;; `make-variable-buffer-local' and free variable references.

(defvar my-keys-minor-mode-map
  (let ((map (make-sparse-keymap)))
    ;; Window movement
    (define-key map (kbd "M-<left>") #'windmove-left)
    (define-key map (kbd "M-<right>") #'windmove-right)
    (define-key map (kbd "M-<up>") #'windmove-up)
    (define-key map (kbd "M-<down>") #'windmove-down)

    ;; Window resize
    (define-key map (kbd "C-S-<up>") #'enlarge-window)
    (define-key map (kbd "C-S-<down>") #'shrink-window)

    ;; Text operations
    (define-key map (kbd "C-c w d") #'delete-trailing-whitespace)
    (define-key map (kbd "C-x C-k") #'my-kill-last-opened-buffer)
    (define-key map (kbd "C-<delete>") #'my-join-next-line)
    (define-key map (kbd "C-c C-s") #'my-sort-ilines)

    ;; Open file from ssh
    (define-key map (kbd "C-c C-f") #'my-open-remote-home)

    ;; Cross-reference.  These used to live in dumb-jump-mode-map, whose
    ;; minor mode is deprecated in favour of the xref backend.
    (define-key map (kbd "C-c C-l") #'xref-find-definitions)
    (define-key map (kbd "C-c C-b") #'xref-go-back)

    ;; Compilation (see the note on interrupt-and-recompile above)
    (define-key map (kbd "<f6>") #'interrupt-and-recompile)
    (define-key map (kbd "C-c c") #'interrupt-and-recompile)

    map)
  "Keymap for `my-keys-minor-mode'.")

(define-minor-mode my-keys-minor-mode
  "A minor mode so that my key settings override annoying major modes."
  :init-value t
  :lighter " my-keys"
  :keymap my-keys-minor-mode-map)

(define-globalized-minor-mode global-my-keys-minor-mode
  my-keys-minor-mode
  (lambda () (my-keys-minor-mode 1))
  :group 'convenience)

(global-my-keys-minor-mode 1)

