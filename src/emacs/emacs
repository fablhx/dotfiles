;;; Commentary:
;; Symlinked as ~/.emacs.  Requires Emacs 29.1+, which bundles use-package and
;; tree-sitter.
;;
;; Function keys, which are spread across the blocks below:
;;   f1 comment-dwim   f2 whitespace-mode  f3 rg          f4 flycheck-mode
;;   f5 compile        f6 recompile        f7 next-error  f8 pop mark
;;   f9 open error location at point       f12 enlarge-window
;; Shift adds: f3 rg-project, f8 pop-global-mark.

;;; Code:

;; =============================================================================
;;                                  Startup
;; =============================================================================

;; Emacs reads this file with the GC threshold at 800 kB and the file name
;; handlers armed, which buys a collection every few files loaded and a regexp
;; sweep per `load'.  Neither pays off before the first frame exists.  The
;; originals are restored from `emacs-startup-hook', which Emacs runs even when
;; this file signals partway through.
(defconst my-startup-file-name-handler-alist file-name-handler-alist)

(setq gc-cons-threshold most-positive-fixnum
      gc-cons-percentage 0.6
      file-name-handler-alist nil)

(defun my-restore-startup-defaults ()
  "Undo the startup-only performance settings made at the top of this file."
  ;; Not the 800 kB default: collecting that often costs more in a long-lived
  ;; session, with LSP and flycheck allocating, than the pauses it avoids.
  (setq gc-cons-threshold (* 32 1024 1024)
        gc-cons-percentage 0.1
        file-name-handler-alist my-startup-file-name-handler-alist))

(add-hook 'emacs-startup-hook #'my-restore-startup-defaults)

;; =============================================================================
;;                             Package Management
;; =============================================================================

;; eval-and-compile: `:ensure' runs at macro-expansion time, so MELPA must be
;; registered by then or every MELPA-only package reports "Package is
;; unavailable" when this file is byte-compiled.
(eval-and-compile
  (require 'package)
  (add-to-list 'package-archives '("melpa" . "https://melpa.org/packages/") t))

(when (version< emacs-version "29.1")
  (error "This configuration requires Emacs 29.1 or newer (running %s)" emacs-version))

(require 'use-package)
;; use-package expands `:bind' into `bind-key' calls, which live in a library it
;; only loads for its own macros; a byte-compiled copy of this file needs it
;; loaded at run time.
(require 'bind-key)
(setq use-package-always-ensure t)

;; Keep `M-x customize' out of this file, which is tracked in git.
(setq custom-file (expand-file-name "custom.el" user-emacs-directory))
(when (file-exists-p custom-file)
  (load custom-file nil t))

;; =============================================================================
;;                           Tree-sitter Grammars
;; =============================================================================

(defconst my-treesit-grammars
  '((rust       . ("https://github.com/tree-sitter/tree-sitter-rust" "v0.20.4" "src"))
    (yaml       . ("https://github.com/ikatyang/tree-sitter-yaml"))
    (typescript . ("https://github.com/tree-sitter/tree-sitter-typescript" nil "typescript/src"))
    (tsx        . ("https://github.com/tree-sitter/tree-sitter-typescript" nil "tsx/src")))
  "Grammar sources, pinned where a revision matters for this Emacs ABI.")

(defconst my-treesit-file-modes
  '(("\\.ts\\'"    typescript typescript-ts-mode typescript-mode)
    ("\\.tsx\\'"   tsx        tsx-ts-mode        typescript-mode)
    ("\\.ya?ml\\'" yaml       yaml-ts-mode       conf-mode))
  "File types served by a tree-sitter mode when its grammar is installed.
Each entry is (REGEXP LANGUAGE TS-MODE FALLBACK-MODE).")

(require 'treesit nil t)

(when (treesit-available-p)
  (dolist (entry my-treesit-grammars)
    (add-to-list 'treesit-language-source-alist
                 (cons (car entry) (cdr entry)))))

(defun my-treesit-mode-if-available (lang ts-mode fallback-mode)
  "Return TS-MODE when grammar LANG is usable, else FALLBACK-MODE."
  (if (and (treesit-available-p)
           (treesit-language-available-p lang))
      ts-mode
    fallback-mode))

(defun my-set-auto-mode (regexp mode)
  "Bind REGEXP to MODE in `auto-mode-alist', replacing any entry for REGEXP.
Replacing rather than pushing is what lets the registration below be re-run
after a grammar is installed."
  (setq auto-mode-alist
        (cons (cons regexp mode)
              (assoc-delete-all regexp auto-mode-alist))))

(defun my-treesit-register-auto-modes ()
  "Point every `my-treesit-file-modes' entry at the best mode available now."
  (dolist (entry my-treesit-file-modes)
    (my-set-auto-mode (nth 0 entry)
                      (my-treesit-mode-if-available (nth 1 entry)
                                                    (nth 2 entry)
                                                    (nth 3 entry)))))

(defun my-install-treesit-grammars ()
  "Compile and install every grammar in `my-treesit-grammars'.
Run this once by hand.  Grammars are deliberately not built during startup
or on first visiting a file: it needs git plus a C compiler and blocks for
tens of seconds."
  (interactive)
  (unless (treesit-available-p)
    (user-error "This Emacs was built without tree-sitter support"))
  (dolist (entry my-treesit-grammars)
    (let ((lang (car entry)))
      (if (treesit-language-available-p lang)
          (message "Grammar %s already installed" lang)
        (message "Installing grammar %s..." lang)
        (condition-case err
            (treesit-install-language-grammar lang)
          (error (message "Failed to install %s: %s"
                          lang (error-message-string err)))))))
  ;; Hand the affected file types over to their tree-sitter modes now, so a
  ;; freshly installed grammar takes effect without restarting Emacs.
  (my-treesit-register-auto-modes))

;; =============================================================================
;;                                Remote Hosts
;; =============================================================================

(defun my-sanitize-ssh-value (value)
  "Sanitize SSH config values to prevent path injection.
Returns VALUE if it contains only safe characters, nil otherwise.
Wildcard patterns are rejected: they configure defaults rather than name a
host that can be connected to."
  (when (and value
             (stringp value)
             (not (string-empty-p value))
             (string-match-p "\\`[a-zA-Z0-9._-]+\\'" value))
    value))

(defun my-ssh-config-host-alist (&optional file)
  "Parse FILE, by default ~/.ssh/config, and return an alist of (HOST . USER).
USER is nil for a host whose block names none.  Returns nil when the file
does not exist or cannot be read."
  (let ((file (or file (expand-file-name "~/.ssh/config"))))
    (if (not (file-readable-p file))
        (progn
          (message "SSH config file not found or not readable: %s" file)
          nil)
      (condition-case err
          (with-temp-buffer
            (insert-file-contents file)
            (goto-char (point-min))
            ;; ssh_config keywords are case-insensitive, and `case-fold-search'
            ;; is buffer-local: bind it rather than inherit the caller's.
            (let ((case-fold-search t)
                  (hosts nil)
                  (block nil))
              (while (not (eobp))
                (cond
                 ;; A Host line opens a new block, so any User below it belongs
                 ;; to these names only.  That holds for the patterns dropped by
                 ;; `my-sanitize-ssh-value' too: `Host *' leaves BLOCK empty, and
                 ;; its User must not fall back to the host declared above.
                 ((looking-at "[ \t]*Host[ \t]+\\(.*\\)$")
                  (setq block nil)
                  (dolist (name (split-string (match-string 1) "[ \t]+" t))
                    (when (my-sanitize-ssh-value name)
                      (let ((cell (cons name nil)))
                        (push cell hosts)
                        (push cell block)))))
                 ((looking-at "[ \t]*Match[ \t]")
                  (setq block nil))
                 ((and block (looking-at "[ \t]*User[ \t]+\\([^ \t\n]+\\)"))
                  (let ((user (my-sanitize-ssh-value (match-string 1))))
                    (when user
                      (dolist (cell block)
                        (setcdr cell user))))))
                (forward-line 1))
              (nreverse hosts)))
        (error
         (message "Error parsing SSH config: %s" (error-message-string err))
         nil)))))

(defun my-open-remote-home ()
  "Prompt for an SSH host and open its home directory over TRAMP.
The remote user is taken from ~/.ssh/config when it names one."
  (interactive)
  (let ((host-alist (my-ssh-config-host-alist)))
    (if (null host-alist)
        (message "No SSH hosts found in configuration file")
      (let* ((host (completing-read "SSH host: " (mapcar #'car host-alist) nil t))
             (user (or (cdr (assoc host host-alist)) (user-login-name))))
        ;; Both values were sanitized while parsing; they are checked again here
        ;; because this is where they are spliced into a path.
        (unless (my-sanitize-ssh-value host)
          (error "Invalid host name: %s" host))
        (unless (my-sanitize-ssh-value user)
          (error "Invalid user name: %s" user))
        (let ((remote-path (format "/ssh:%s@%s:~/" user host)))
          (message "Opening %s" remote-path)
          (condition-case err
              (find-file remote-path)
            (error
             (message "Failed to open remote path: %s"
                      (error-message-string err)))))))))

