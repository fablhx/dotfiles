;; Language Server Protocol support
;; Servers needed:
;;   Rust:  rustup component add rust-analyzer
;;   C/C++: apt install clangd
;;   OCaml: opam install ocaml-lsp-server
;;   Bash:  npm i -g bash-language-server
(use-package lsp-mode
  :ensure t
  :commands (lsp lsp-deferred)
  :init
  (setq lsp-keymap-prefix "C-c l")
  ;; A language server answers in bursts far larger than the 4 kB default, and
  ;; every short read costs a process-filter round trip.
  (setq read-process-output-max (* 1024 1024))
  ;; :custom, not setq in :config: these apply as each defcustom is evaluated,
  ;; which is what settles lsp-clients-clangd-executable before lsp-clangd loads.
  :custom
  (lsp-idle-delay 0.5)
  (lsp-log-io nil)
  (lsp-enable-file-watchers nil)
  (lsp-enable-folding nil)
  (lsp-enable-snippet t)
  (lsp-enable-symbol-highlighting t)
  (lsp-lens-enable nil)
  (lsp-headerline-breadcrumb-enable nil)

  ;; --- Inlay hints ---
  ;; Master switch, nil by default: the per-server hints below are inert
  ;; without it.
  (lsp-inlay-hint-enable t)

  ;; --- Rust (rust-analyzer) ---
  (lsp-rust-analyzer-cargo-watch-command "clippy")
  (lsp-rust-analyzer-display-chaining-hints t)
  (lsp-rust-analyzer-display-parameter-hints t)

  ;; --- C/C++ (clangd) ---
  ;; nil when clangd is absent, which is also the default: let lsp-mode search.
  (lsp-clients-clangd-executable (executable-find "clangd"))
  (lsp-clients-clangd-args '("--background-index"          ; Index in background
                             "--clang-tidy"                ; clang-tidy diagnostics
                             "--completion-style=detailed"
                             "--header-insertion=iwyu"     ; Include-what-you-use
                             "--fallback-style=linux"      ; Match c-default-style
                             "-j=4"))                      ; Parallel indexing jobs

  (lsp-diagnostics-provider :flycheck)

  :hook (;; Rust
         (rust-mode    . lsp-deferred)
         (rust-ts-mode . lsp-deferred)
         (c-mode       . lsp-deferred)
         (c++-mode     . lsp-deferred)
         (lsp-mode . lsp-enable-which-key-integration)
         (lsp-mode . flycheck-mode))
  :bind (:map lsp-mode-map
              ("C-c l h" . lsp-describe-thing-at-point)   ; Show type
              ("C-c l t" . lsp-find-type-definition)      ; Jump to type
              ("C-c l g" . lsp-find-definition)           ; Jump to definition
              ("C-c l r" . lsp-find-references)           ; Find references
              ("C-c l a" . lsp-execute-code-action)       ; Code actions
              ("C-c l R" . lsp-rename)                    ; Rename
              ("C-c l f" . lsp-format-buffer)))

;; Only when ocamllsp exists; otherwise merlin above already owns tuareg-mode.
(when my-ocaml-use-lsp
