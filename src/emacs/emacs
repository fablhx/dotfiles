(defun my-pop-local-mark-ring ()
  "Pop to the local mark ring."
  (interactive)
  (set-mark-command t))

(defun my-kill-last-opened-buffer ()
  "Kill the last opened buffer and its window (useful after grep)."
  (interactive)
  (let ((win-curr (selected-window))
        (win-other (next-window)))
    (if (eq win-curr win-other)
        (message "Only one window exists, cannot kill it")
      (select-window win-other)
      (kill-buffer-and-window)
      (when (window-live-p win-curr)
        (select-window win-curr)))))

(defun my-renumber-list (start end &optional num)
  "Renumber the list items in the current START..END region.
If optional prefix arg NUM is given, start numbering from that number
instead of 1."
  (interactive "*r\np")
  (save-excursion
    (let ((end-marker (copy-marker end))
          (num (or num 1)))
      (goto-char start)
      (save-match-data
        (while (re-search-forward "^\\(-* *\\)\\([0-9]+\\)" end-marker t)
          ;; Literal replacement: the number is data, not a template.
          (replace-match (concat (match-string 1) (number-to-string num)) t t)
          (setq num (1+ num))))
      (set-marker end-marker nil))))

(defun my-join-next-line ()
  "Join next line to the end of current line."
  (interactive)
  (save-excursion
    (move-end-of-line nil)
    (kill-line)
    (just-one-space)))

