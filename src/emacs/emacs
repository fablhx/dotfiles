;; Language Server Protocol support
;; Servers needed:
;;   Rust:  rustup component add rust-analyzer
;;   C/C++: apt install clangd
;;   OCaml: opam install ocaml-lsp-server
;;   Bash:  npm i -g bash-language-server
(use-package lsp-mode
  :ensure t
  :commands (lsp lsp-deferred)
  :init
  (setq lsp-keymap-prefix "C-c l")
  :config
  ;; Performance tuning
  (setq lsp-idle-delay 0.5
        lsp-log-io nil
        lsp-enable-file-watchers nil
        lsp-enable-folding nil
        lsp-enable-snippet t
        lsp-enable-symbol-highlighting t
        lsp-lens-enable nil
        lsp-headerline-breadcrumb-enable nil)

  ;; --- Rust (rust-analyzer) ---
  (setq lsp-rust-analyzer-cargo-watch-command "clippy"
        lsp-rust-analyzer-server-display-inlay-hints t
        lsp-rust-analyzer-display-chaining-hints t
        lsp-rust-analyzer-display-parameter-hints t)

  ;; --- C/C++ (clangd) ---
  (when-let ((clangd (executable-find "clangd")))
    (setq lsp-clients-clangd-executable clangd))
  (setq lsp-clients-clangd-args
        '("--background-index"           ; Index in background
          "--clang-tidy"                  ; Enable clang-tidy diagnostics
          "--completion-style=detailed"   ; Detailed completions
          "--header-insertion=iwyu"       ; Include-what-you-use
          "--fallback-style=linux"        ; Match c-default-style
          "-j=4"))                        ; Parallel indexing jobs

  ;; OCaml and Bash need no configuration: lsp-mode looks for "ocamllsp" and
  ;; "bash-language-server" on PATH.

  ;; Explicitly use flycheck as the diagnostics provider
  (setq lsp-diagnostics-provider :flycheck)

  :hook (;; Rust
         (rust-mode    . lsp-deferred)
         (rust-ts-mode . lsp-deferred)
         ;; C/C++
         (c-mode       . lsp-deferred)
         (c++-mode     . lsp-deferred)
         ;; Common
         (lsp-mode . lsp-enable-which-key-integration)
         (lsp-mode . flycheck-mode))
  :bind (:map lsp-mode-map
              ("C-c l h" . lsp-describe-thing-at-point)   ; Show type
              ("C-c l t" . lsp-find-type-definition)      ; Jump to type
              ("C-c l g" . lsp-find-definition)           ; Jump to definition
              ("C-c l r" . lsp-find-references)           ; Find references
              ("C-c l a" . lsp-execute-code-action)       ; Code actions
              ("C-c l R" . lsp-rename)                    ; Rename
              ("C-c l f" . lsp-format-buffer)))

