# =============================================================================
#                               Bash Configuration
#                             (Warp Terminal / Linux)
# =============================================================================
# Warp draws the prompt (WARP_HONOR_PS1=0) and supplies its own completion
# engine, so neither is configured here: a PS1, a git prompt segment or a
# bash-completion load would all be work whose result Warp discards.

# sshd and rshd hand a non-interactive shell this file too, where every line
# below is either wasted or actively harmful: stray output on stdout corrupts
# scp, sftp and rsync transports.
case $- in
    *i*) ;;
      *) return ;;
esac

[[ $TERM == "dumb" ]] && PS1='$ ' && return

# =============================================================================
#                           Shell Options
# =============================================================================

shopt -s cdspell          # Autocorrect minor cd typos
shopt -s checkwinsize     # Update LINES/COLUMNS after each command
shopt -s dirspell         # Autocorrect directory name typos in completion
shopt -s extglob          # Enable !(...) @(...) +(...) extended globs
shopt -s globstar         # Enable ** recursive glob
shopt -s histappend       # Append to history, don't overwrite

# =============================================================================
#                           History Configuration
# =============================================================================
# Deliberately not exported: bash reads these from its own scope, and every
# exported variable is copied into the environment of every child process.
# Warp prepends its own generator commands to HISTIGNORE at session start.

HISTCONTROL=ignoredups:erasedups:ignorespace
HISTSIZE=50000
HISTFILESIZE=50000
HISTIGNORE="ls:ll:la:l:cd:rm:pwd:exit:clear:history:bg:fg:jobs"

# =============================================================================
#                           Environment Variables
# =============================================================================

export ALTERNATE_EDITOR=""
export BAT_THEME="ansi"
export EDITOR='emacs'
export LESS="-RFX"

# =============================================================================
#                           Command Aliases
# =============================================================================

alias df='df -h'
alias du='du -h'
alias grep='grep --color=auto'
alias rm='rm -I'
alias xclip='xclip -selection clipboard'
alias xopen='xdg-open'

if command -v batcat >/dev/null 2>&1; then
    alias cat='batcat --paging=never --style=plain'
fi

if command -v eza >/dev/null 2>&1; then
    alias ls='eza --color=auto --group-directories-first'
    alias l='eza -lh'
    alias ll='eza -lh'
    alias lll='eza -lha'
    alias la='eza -ld .*'
    alias lt='eza -lh --sort=time'
else
    alias ls='ls --color=auto -v'
    alias l='ls -lh'
    alias ll='ls -lh'
    alias lll='ls -lha'
    alias la='ls -lhd .?*'
    alias lt='ls -lht'
fi

if command -v tree >/dev/null 2>&1; then
    alias tree='tree -C'
fi

if command -v fdfind >/dev/null 2>&1; then
    alias fd='fdfind'
fi

# =============================================================================
#                           Emacs Integration
# =============================================================================

__emacs_client() {
    local frames

    # Reuse an existing frame rather than piling up empty ones. Matching on a
    # count rather than searching the reply for "t" matters: an Emacs error
    # message contains letters too, and would otherwise be read as a frame.
    frames=$(emacsclient -n -e '(length (frame-list))' 2>/dev/null)

    if [[ ${frames} =~ ^[0-9]+$ ]] && (( frames > 1 )); then
        emacsclient -n "$@"
    else
        emacsclient -c -n "$@"
    fi
}

alias cedit='emacsclient -c -nw'    # Console edit
alias wedit='__emacs_client'        # Window edit
alias start_emacs='emacs --daemon'  # Start daemon
alias stop_emacs='emacsclient -e "(kill-emacs)"'  # Stop daemon

# =============================================================================
#                           Prompt sync
# =============================================================================

__history_sync() {
    history -a
    history -n
}

# Share history between shells. Guarded so re-sourcing this file does not keep
# prepending, and array-aware because bash 5.1+ lets PROMPT_COMMAND be one --
# assigning a string to an array variable would drop every other hook in it,
# and Warp installs hooks of its own here.
if [[ ${PROMPT_COMMAND[*]} != *__history_sync* ]]; then
    if [[ ${PROMPT_COMMAND@a} == *a* ]]; then
        PROMPT_COMMAND=( __history_sync "${PROMPT_COMMAND[@]}" )
    else
        PROMPT_COMMAND="__history_sync${PROMPT_COMMAND:+; ${PROMPT_COMMAND}}"
    fi
fi

# =============================================================================
#                           Private / Corporate
# =============================================================================

# Untracked, and sourced last so it can override anything above.
[[ -f "${HOME}/.bashrc.private" ]] && source "${HOME}/.bashrc.private"
